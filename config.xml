<?xml version='1.0' encoding='utf-8'?>
<widget
    id="com.example.scanditui5scanner"
    version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>ScanditUI5Scanner</name>
    <description>SAP UI5 Barcode Scanner powered by Scandit</description>
    <author email="dev@example.com" href="https://example.com">Developer</author>

    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <!-- Android platform config -->
    <platform name="android">
        <allow-intent href="market:*" />

        <uses-permission android:name="android.permission.CAMERA" />
        <uses-feature android:name="android.hardware.camera" android:required="true" />

        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="android-compileSdkVersion" value="35" />
        <preference name="GradlePluginKotlinEnabled" value="true" />
        <preference name="GradlePluginKotlinVersion" value="1.9.25" />
        <preference name="GradleVersion" value="8.14.3" />
        <preference name="AndroidGradlePluginVersion" value="8.5.2" />
    </platform>

    <!-- iOS platform config -->
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />

        <!-- Required for iOS camera permission dialog -->
        <edit-config file="*-Info.plist" target="NSCameraUsageDescription" mode="merge">
            <string>This app requires camera access to scan barcodes.</string>
        </edit-config>

        <preference name="SwiftVersion" value="5" />
        <preference name="deployment-target" value="15.0" />
    </platform>

</widget>
